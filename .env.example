# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Get a FREE Groq API key at: https://console.groq.com  (no credit card needed)
# ──────────────────────────────────────────────────────────────────────────────

# Required — FREE Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_...your-key-here...

# Optional — override defaults
# Free Groq models: llama3-8b-8192 | llama3-70b-8192 | mixtral-8x7b-32768 | gemma2-9b-it
LLM_MODEL=llama3-8b-8192
LLM_TEMPERATURE=0

# Local embedding model (downloaded once ~90MB, runs on CPU, completely free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
RETRIEVER_TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ChromaDB
CHROMA_COLLECTION=kt_knowledge_base
VECTORSTORE_DIR=vectorstore
UPLOADS_DIR=uploads

# Streamlit frontend backend URL
BACKEND_URL=http://localhost:8000
