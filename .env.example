# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored — never commit real secrets.
#
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Required ─────────────────────────────────────────────────────────────────────
# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...your-key-here...

# Optional — override defaults ─────────────────────────────────────────────────
# LLM model to use for generation and grading
LLM_MODEL=gpt-4o-mini

# Temperature for generation (0 = deterministic)
LLM_TEMPERATURE=0

# OpenAI embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Number of chunks to retrieve per query
RETRIEVER_TOP_K=6

# Chunk size and overlap for text splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ChromaDB collection name
CHROMA_COLLECTION=kt_knowledge_base

# Directory where ChromaDB stores its files
VECTORSTORE_DIR=vectorstore

# Directory where uploaded PDFs are saved
UPLOADS_DIR=uploads

# Streamlit frontend — URL of the FastAPI backend
# Set this to your Render kt-api URL when deploying
BACKEND_URL=http://localhost:8000
